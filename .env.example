# ---------------------------------------------------------------------------
# Sowline India — environment
#
# Copy to .env.local and fill in. PLACEHOLDER VALUES ONLY IN THIS FILE.
# The app runs with none of these set: it falls back to a deterministic seed
# bundle executed in-process, and every screen labels itself as such.
# ---------------------------------------------------------------------------

# --- API auth (every /api route requires the x-api-key header) -------------
X_API_KEY=abc
NEXT_PUBLIC_X_API_KEY=abc

# --- Gemini ----------------------------------------------------------------
# Server-only. Never exposed to the browser: /api/live/token mints a
# short-lived ephemeral token for the Live session instead.
GEMINI_API_KEY=your-gemini-api-key-here

# Model IDs move often on the developer tier. Check
# https://ai.google.dev/gemini-api/docs/models on the day.
#
# The live model must be able to CALL TOOLS, not just talk. On 2026-08-08 the
# gemini-2.5-flash-native-audio-* models answered in fluent Tamil and never
# emitted a single tool call, which leaves the form empty. Verify with
# `node scripts/live-smoke.mjs` before changing this.
NEXT_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
NEXT_PUBLIC_GEMINI_VOICE=Aoede
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_MAPPING_MODEL=gemini-2.5-flash

# --- Firebase (browser SDK) -------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Firebase Admin (server) ------------------------------------------------
# Either point at a service-account file...
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# ...or inline the same JSON on one line (Cloud Run):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=your-project-id
