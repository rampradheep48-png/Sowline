{
  "name": "agri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:dry": "tsx --conditions=react-server scripts/seed.ts --dry",
    "engine": "curl -s -X POST -H \"x-api-key: ${X_API_KEY:-abc}\" http://localhost:3000/api/engine/run | head -c 2000",
    "typecheck": "tsc --noEmit",
    "smoke:voice": "tsx scripts/live-smoke.mjs",
    "smoke:docs": "node scripts/vision-smoke.mjs",
    "smoke:advisor": "tsx scripts/advisor-smoke.mjs",
    "smoke:context": "tsx --conditions=react-server scripts/advisor-context-smoke.ts",
    "fixtures": "python3 scripts/make-doc-fixtures.py",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}